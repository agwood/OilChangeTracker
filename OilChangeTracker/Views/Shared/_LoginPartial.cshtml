@if (User.Identity.IsAuthenticated)
{
    <ul class="nav navbar-nav navbar-right">
        <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" style="color: inherit; text-decoration: none;">@User.Identity.Name <span class="caret"></span></a>
            <ul class="dropdown-menu">
                <li><a asp-action="Index" asp-controller="Vehicles">Your Garage</a></li>
                <li><a asp-action="Create" asp-controller="OilChanges">Add Oil Change</a></li>
                <li role="separator" class="divider"></li>
                <li><a href="javascript:document.getElementById('logoutForm').submit()">Log off</a></li>
            </ul>
        </li>
    </ul>
    <form id="logoutForm" asp-action="LogOff" asp-controller="Account" method="post" style="display:none;"></form>
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li><a asp-action="Register" asp-controller="Account">Register</a></li>
        <li><a asp-action="Login" asp-controller="Account">Log in</a></li>
    </ul>
}
